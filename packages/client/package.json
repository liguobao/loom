{
  "name": "dsh-loom",
  "version": "0.1.0",
  "description": "Loom plugin for DeepSeek Harness — Keep the work, not the chat.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loom/protocol": "workspace:*",
    "@loom/distill": "workspace:*",
    "@loom/crypto": "workspace:*",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  }
}
