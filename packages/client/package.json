{
  "name": "@loom/client",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "loom": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --banner.js '#!/usr/bin/env node'",
    "dev": "tsup src/index.ts src/cli.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loom/protocol": "workspace:*",
    "@loom/distill": "workspace:*",
    "@loom/crypto": "workspace:*",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "conf": "^13.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "commander": "^12.1.0",
    "inquirer": "^10.1.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  }
}
