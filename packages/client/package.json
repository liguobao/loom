{
  "name": "dsh-loom",
  "version": "0.1.0",
  "description": "Loom plugin for DeepSeek Harness — Keep the work, not the chat.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@loom/protocol": "workspace:*",
    "@loom/distill": "workspace:*",
    "@loom/crypto": "workspace:*",
    "@types/ws": "^8.5.12",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
